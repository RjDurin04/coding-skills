{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portable-agent-governance:schema:routing-model-adapter:1",
  "title": "Routing Model Adapter Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "argv",
    "environment_allowlist",
    "model",
    "instruction_binding"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/routing-model-adapter.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "argv": {
      "description": "Direct process argv with no shell expansion. This configuration must remain secret-free. The runner applies only best-effort credential heuristics; use environment_allowlist for variable names and external secret scanning for enforcement.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment_allowlist": {
      "description": "Names of environment variables inherited by the adapter. Values never belong in this file.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "instruction_binding": {
      "description": "How the adapter binds this governance pack to the evaluated model surface.",
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "version",
        "agent_surface"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "agent_surface": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
