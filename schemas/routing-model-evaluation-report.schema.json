{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portable-agent-governance:schema:routing-model-evaluation-report:1",
  "title": "Routing Model Evaluation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "rules_pack_version",
    "generated_at",
    "catalog",
    "execution",
    "adapters",
    "comparison",
    "status"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/routing-model-evaluation-report.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "rules_pack_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "catalog": {
      "$ref": "#/$defs/catalog"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/adapterResult"
      }
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "status": {
      "$ref": "#/$defs/topStatus"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "catalog": {
            "properties": {
              "visibility": {
                "const": "private"
              }
            },
            "required": [
              "visibility"
            ]
          }
        },
        "required": [
          "catalog"
        ]
      },
      "then": {
        "properties": {
          "adapters": {
            "items": {
              "properties": {
                "cases": {
                  "items": {
                    "properties": {
                      "case_ref": {
                        "$ref": "#/$defs/privateCaseRef"
                      },
                      "variant_of": {
                        "oneOf": [
                          {
                            "$ref": "#/$defs/privateCaseRef"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "trials": {
                        "items": {
                          "properties": {
                            "score": {
                              "type": "null"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "selection_scope": {
                "const": "partial"
              }
            },
            "required": [
              "selection_scope"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "FAIL",
              "INVALID",
              "ERROR",
              "PARTIAL"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "$ref": "#/$defs/status"
          }
        }
      }
    }
  ],
  "$defs": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "sha256",
        "variants_sha256",
        "base_case_count",
        "variant_count"
      ],
      "properties": {
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variants_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "base_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "variant_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trials",
        "timeout_seconds",
        "max_request_bytes",
        "max_output_bytes",
        "max_invocations",
        "planned_invocations",
        "selection_scope",
        "selected_case_count",
        "workspace_observation_scope",
        "process_containment"
      ],
      "properties": {
        "trials": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_invocations": {
          "type": "integer",
          "minimum": 1
        },
        "planned_invocations": {
          "type": "integer",
          "minimum": 1
        },
        "selection_scope": {
          "enum": [
            "full",
            "partial"
          ]
        },
        "selected_case_count": {
          "type": "integer",
          "minimum": 1
        },
        "workspace_observation_scope": {
          "const": "disposable_cwd_only"
        },
        "process_containment": {
          "enum": [
            "windows_job_plus_observed_descendants",
            "posix_process_group"
          ]
        }
      }
    },
    "adapterResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "config_sha256",
        "model",
        "instruction_binding",
        "summary",
        "cases",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "instruction_binding": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseResult"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "version",
        "agent_surface"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "agent_surface": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_trials",
        "pass",
        "fail",
        "invalid",
        "error",
        "pass_rate",
        "workspace_mutation_trials",
        "critical_failure_trials"
      ],
      "properties": {
        "total_trials": {
          "type": "integer",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "workspace_mutation_trials": {
          "type": "integer",
          "minimum": 0
        },
        "critical_failure_trials": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_ref",
        "variant_of",
        "trials"
      ],
      "properties": {
        "case_ref": {
          "type": "string",
          "minLength": 1
        },
        "variant_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "trials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trial"
          }
        }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial",
        "started_at",
        "duration_seconds",
        "status",
        "decision",
        "score",
        "failure_classes",
        "workspace",
        "process"
      ],
      "properties": {
        "trial": {
          "type": "integer",
          "minimum": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "decision": {
          "oneOf": [
            {
              "$ref": "#/$defs/decision"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "failure_classes": {
          "$ref": "#/$defs/stringSet"
        },
        "workspace": {
          "$ref": "#/$defs/workspace"
        },
        "process": {
          "$ref": "#/$defs/process"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "signals",
        "risk",
        "confirmation",
        "lead_skill",
        "supporting_skills"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "signals": {
          "$ref": "#/$defs/stringSet"
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "confirmation": {
          "type": "string",
          "minLength": 1
        },
        "lead_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "supporting_skills": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutated",
        "changed_count",
        "path_digests",
        "scan_overflow"
      ],
      "properties": {
        "mutated": {
          "type": "boolean"
        },
        "changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "path_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "scan_overflow": {
          "type": "boolean"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "timed_out",
        "output_limited",
        "stdout_bytes",
        "stderr_bytes",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "output_limited": {
          "type": "boolean"
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_count",
        "shared_case_count",
        "comparable",
        "all_adapters_pass",
        "status_by_adapter"
      ],
      "properties": {
        "adapter_count": {
          "type": "integer",
          "minimum": 1
        },
        "shared_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "comparable": {
          "type": "boolean"
        },
        "all_adapters_pass": {
          "type": "boolean"
        },
        "status_by_adapter": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/status"
          }
        }
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INVALID",
        "ERROR"
      ]
    },
    "topStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "INVALID",
        "ERROR",
        "PARTIAL"
      ]
    },
    "privateCaseRef": {
      "type": "string",
      "pattern": "^private-[a-f0-9]{64}$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
