{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portable-agent-governance:schema:governance-scenarios:2",
  "title": "Governance Composition Scenarios v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "scenarios"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/governance-scenarios.schema.json"
    },
    "schema_version": {
      "const": 2
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "request",
        "expected_mode",
        "signals",
        "negative_signals",
        "expected_risk",
        "expected_confirmation",
        "expected_rules",
        "expected_lead_skill",
        "expected_supporting_skills"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "request": {
          "type": "string",
          "minLength": 1
        },
        "expected_mode": {
          "enum": [
            "answer",
            "review",
            "diagnose",
            "design",
            "implement",
            "operate"
          ]
        },
        "signals": {
          "$ref": "#/$defs/stringSet"
        },
        "negative_signals": {
          "$ref": "#/$defs/stringSet"
        },
        "expected_risk": {
          "$ref": "#/$defs/risk"
        },
        "expected_confirmation": {
          "$ref": "#/$defs/confirmation"
        },
        "expected_rules": {
          "$ref": "#/$defs/stringSet"
        },
        "expected_lead_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_supporting_skills": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk": {
      "enum": [
        "trivial",
        "standard",
        "structural",
        "critical"
      ]
    },
    "confirmation": {
      "enum": [
        "none",
        "explicit_authorization",
        "fresh_confirmation"
      ]
    }
  }
}
