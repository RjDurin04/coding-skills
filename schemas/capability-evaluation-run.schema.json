{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portable-agent-governance:schema:capability-evaluation-run:2",
  "title": "Capability Evaluation Run v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "case_id",
    "rules_pack_version",
    "model",
    "execution",
    "runner",
    "reviewer",
    "artifacts",
    "dimension_scores",
    "criterion_results",
    "automatic_failure_reason_ids",
    "notes"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/capability-evaluation-run.schema.json"
    },
    "schema_version": {
      "const": 2
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "rules_pack_version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "runner": {
      "$ref": "#/$defs/identity"
    },
    "reviewer": {
      "$ref": "#/$defs/identity"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "dimension_scores": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/score"
      },
      "minProperties": 1
    },
    "criterion_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterionResult"
      }
    },
    "automatic_failure_reason_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "version",
        "agent_surface"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "agent_surface": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "started_at",
        "duration_seconds",
        "token_measure"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "token_measure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "value"
          ],
          "properties": {
            "unit": {
              "enum": [
                "tokens",
                "usd",
                "other"
              ]
            },
            "value": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "organization"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "human",
            "agent",
            "automation"
          ]
        },
        "organization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "media_type",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "criterionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "status",
        "evidence_artifact_ids",
        "review_notes"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "satisfied",
            "violated",
            "unverified"
          ]
        },
        "evidence_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
