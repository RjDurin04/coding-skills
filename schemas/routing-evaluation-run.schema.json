{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portable-agent-governance:schema:routing-evaluation-run:1",
  "title": "Raw Request Routing Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "case_id",
    "rules_pack_version",
    "model",
    "runner",
    "started_at",
    "duration_seconds",
    "decision",
    "notes"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/routing-evaluation-run.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "rules_pack_version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "runner": {
      "$ref": "#/$defs/identity"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "version",
        "agent_surface"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "agent_surface": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "organization"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "human",
            "agent",
            "automation"
          ]
        },
        "organization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "signals",
        "risk",
        "confirmation",
        "lead_skill",
        "supporting_skills"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "signals": {
          "$ref": "#/$defs/stringSet"
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "confirmation": {
          "type": "string",
          "minLength": 1
        },
        "lead_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "supporting_skills": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
